{
  "name": "task-ui",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist coverage infrastructure/cdk.out",
    "clean:all": "rimraf dist node_modules coverage infrastructure/node_modules infrastructure/cdk.out",
    "dev": "vite --open",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "cdk": "cd infrastructure && npm run cdk",
    "cdk:deploy": "npm run build && cd infrastructure && npm run deploy",
    "cdk:destroy": "cd infrastructure && npm run destroy",
    "cdk:diff": "cd infrastructure && npm run diff",
    "cdk:synth": "cd infrastructure && npm run synth",
    "cdk:install": "./infrastructure/install.sh",
    "cdk:env": "cp infrastructure/.env.example infrastructure/.env && echo 'Created .env file in infrastructure directory. Edit this file to set your deployment configuration.'"
  },
  "dependencies": {
    "@hookform/resolvers": "5.1.1",
    "@radix-ui/react-checkbox": "1.3.2",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.14",
    "@radix-ui/react-slot": "1.2.3",
    "@tailwindcss/vite": "4.1.10",
    "@tanstack/react-query": "5.80.7",
    "axios": "1.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.517.0",
    "react": "19.1.0",
    "react-day-picker": "9.7.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.58.1",
    "react-router-dom": "7.6.2",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.10",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@tanstack/react-query-devtools": "5.80.7",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.0.3",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "eslint": "9.29.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.2.0",
    "jsdom": "26.1.0",
    "rimraf": "6.0.1",
    "tw-animate-css": "1.3.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.1",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
