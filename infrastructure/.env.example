# CDK Environment Variables for deployment

# The environment name (e.g., dev, test, prod)
CDK_ENV=dev

# Comma-separated list of domain names (optional)
# Example: CDK_DOMAIN_NAMES=example.com,www.example.com
CDK_DOMAIN_NAMES=

# ACM certificate ARN for custom domain (optional)
# Example: CDK_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/abcd1234-abcd-1234-abcd-1234abcd5678
CDK_CERTIFICATE_ARN=
